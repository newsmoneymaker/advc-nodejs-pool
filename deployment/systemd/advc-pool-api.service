[Unit]
Description=AdventureCoin pool: public API (127.0.0.1:8150)
After=advc-pool-redis.service advc-node.service
Requires=advc-pool-redis.service
[Service]
Type=simple
User=advcpool
WorkingDirectory=/opt/advc-nodejs-pool
ExecStart=/usr/bin/node /opt/advc-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
