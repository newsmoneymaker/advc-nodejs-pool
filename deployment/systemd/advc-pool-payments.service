[Unit]
Description=AdventureCoin pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=advc-pool-redis.service advc-node.service
Requires=advc-pool-redis.service
[Service]
Type=simple
User=advcpool
WorkingDirectory=/opt/advc-nodejs-pool
ExecStart=/usr/bin/node /opt/advc-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
