{
  "poolHost": "pool.example.org",
  "coin": "AdventureCoin",
  "symbol": "ADVC",
  "coinUnits": 100000000,
  "coinDecimalPlaces": 8,
  "coinDifficultyTarget": 180,
  "addressVersion": 23,
  "scriptAddressVersion": 10,
  "bech32Hrp": "advc",
  "blockchainExplorer": "https://explorer.adventurecoin.quest/#/block/{id}",
  "transactionExplorer": "https://explorer.adventurecoin.quest/#/transaction/{id}",
  "logging": {
    "files": {
      "level": "info",
      "directory": "logs",
      "flushInterval": 5
    },
    "console": {
      "level": "info",
      "colors": true
    }
  },
  "poolServer": {
    "enabled": true,
    "mergedMining": false,
    "clusterForks": 1,
    "minerTimeout": 240,
    "sslCert": "/etc/ssl/fullchain.pem",
    "sslKey": "/etc/ssl/privkey.pem",
    "sslCA": "./chain.pem",
    "ports": [
      {
        "port": 5500,
        "desc": "ADVC stratum (plain TCP, difficulty adjusts to your hashrate)"
      },
      {
        "port": 5501,
        "desc": "ADVC stratum over TLS (encrypted)",
        "tls": true
      },
      {
        "port": 5502,
        "desc": "ADVC stratum over TLS (alternative port)",
        "tls": true
      },
      {
        "port": 5503,
        "desc": "ADVC stratum over TLS (alternative port)",
        "tls": true
      }
    ],
    "banning": {
      "enabled": true,
      "time": 600,
      "invalidPercent": 25,
      "checkThreshold": 30
    },
    "slushMining": {
      "enabled": true,
      "weight": 86400
    },
    "bindIp": "0.0.0.0",
    "allowIPs": [],
    "maxConnectionsPerIp": 100,
    "maxUnauthenticatedPerIp": 10,
    "loginTimeout": 20,
    "maxConnections": 3000,
    "varDiff": {
      "startDiff": 5000,
      "minDiff": 1000,
      "maxDiff": 5000000,
      "targetTime": 20,
      "retargetTime": 60,
      "variancePercent": 30,
      "maxJump": 100
    },
    "jobRefresh": 1000,
    "poolAddress": "YOUR_POOL_ADDRESS",
    "templateRefresh": 30,
    "coinbaseTag": "/pool.example.org/"
  },
  "payments": {
    "enabled": true,
    "interval": 600,
    "minPayment": 100000000,
    "maxTransactionAmount": 1000000000000,
    "maxPaymentsPerRound": 50,
    "minConfirmations": 6,
    "pendingTimeoutHours": 48,
    "reserve": 1000000,
    "minerPayFee": true,
    "dryRun": true,
    "onlyAccounts": [],
    "stopFile": "/opt/advc-nodejs-pool/STOP_PAYMENTS"
  },
  "blockUnlocker": {
    "enabled": true,
    "interval": 60,
    "depth": 110,
    "poolFee": 1,
    "networkFee": 0,
    "donations": {
      "AVbZ5LXcgFz5HFXw1Bdwspx64zRQvqVETF": 1
    }
  },
  "api": {
    "enabled": true,
    "hashrateWindow": 600,
    "updateInterval": 5,
    "bindIp": "127.0.0.1",
    "port": 8150,
    "blocks": 30,
    "payments": 30,
    "password": "CHANGE_ME",
    "ssl": false,
    "sslPort": 8120,
    "sslCert": "./cert.pem",
    "sslKey": "./privkey.pem",
    "sslCA": "./chain.pem",
    "trustProxyIP": true
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6408,
    "auth": "CHANGE_ME",
    "db": 0,
    "cleanupInterval": 15
  },
  "prices": {
    "source": "tradeogre",
    "currency": "USD"
  },
  "charts": {
    "pool": {
      "hashrate": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "miners": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "workers": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "difficulty": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      },
      "price": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      },
      "profit": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      }
    },
    "user": {
      "hashrate": {
        "enabled": true,
        "updateInterval": 180,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "worker_hashrate": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 60,
        "maximumPeriod": 86400
      },
      "payments": {
        "enabled": true
      }
    },
    "blocks": {
      "enabled": true,
      "days": 30
    }
  },
  "node": {
    "host": "127.0.0.1",
    "port": 9982,
    "user": "advcpool",
    "passwordFile": "/opt/advc/data/rpc.pass"
  },
  "hasher": {
    "path": "/opt/advc-nodejs-pool/hasher/yphash",
    "threads": 2
  }
